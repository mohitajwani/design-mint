{
  "name": "@designmint/cli",
  "version": "0.1.0",
  "description": "CLI for DesignMint — interactive design system setup, generation, export, and accessibility audit",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "bin": {
    "designmint": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "node --test dist/**/*.test.js",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@designmint/core": "*",
    "commander": "^12.1.0",
    "inquirer": "^12.0.0",
    "chalk": "^5.3.0",
    "ora": "^8.1.0",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/inquirer": "^9.0.7"
  },
  "author": "Mohit Ajwani",
  "license": "MIT"
}
